.entry MAIN
.extern externalRoutine

; --- MACRO DEFINITION ---
; The preprocessor should replace the "setup_regs" call below with two lines.

; --- CODE SEGMENT ---
MAIN: add $3, $5, $9
 move $20, $4
 ori $9, -5, $2
LOOP: bgt $4, $2, ENDPROG
      la K
      sw $0, 4, $10
      bne $31, $9, LOOP
      call externalRoutine
      jmp $4

ENDPROG: hlt

; --- DATA SEGMENT ---
STR:  .asciz "Test"
LIST: .db 6, -9
      .dh 27056
.entry K
K:    .dw 31, -12